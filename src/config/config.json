{
  "site": {
    "title": "MonsterMAC",
    "base_url": "https://monstermac.netlify.app/",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/favicon.png",
    "logo": "/images/MonsterMacDefaultLogo.png",
    "logo_darkmode": "/images/MonsterMacDefaultLogoWt.png",
    "logo_width": "150",
    "logo_height": "30",
    "logo_text": "MonsterMAC"
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 2,
    "summary_length": 200,
    "blog_folder": "blog"
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "Copyright © 2026 MonsterMAC. All Rights Reserved."
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": true,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
"meta_author": "MonsterMAC",
"meta_description": "Solusi Vending Machine Modern 24/7 untuk Efisiensi dan Profitabilitas Bisnis Anda."
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
