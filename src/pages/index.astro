---
import BaseLayout from "@/layouts/Base.astro";
---

<BaseLayout title="Solusi Vending Machine Modern 24/7">
  
  <!-- 1. HERO SECTION -->
  <section class="bg-gradient-to-r from-blue-900 to-indigo-800 text-white py-20 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <span class="bg-blue-600 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">Aksesibilitas 24/7</span>
      <h1 class="text-4xl md:text-6xl font-extrabold mt-4 mb-6 leading-tight">
        Temukan Beragam Produk dengan Aksesibilitas 24/7
      </h1>
      <p class="text-lg md:text-xl text-blue-100 max-w-3xl mx-auto mb-8">
        Efisiensi, profitabilitas, dan kepuasan pelanggan adalah solusi bisnis andalan kami. Tingkatkan penjualan Anda tanpa ribet.
      </p>
      <div class="flex justify-center gap-4">
        <a href="#kontak" class="bg-amber-400 hover:bg-amber-500 text-gray-900 font-bold px-8 py-3 rounded-lg transition duration-300 shadow-lg">
          KONTAK KAMI
        </a>
        <a href="#produk" class="bg-transparent border-2 border-white text-white font-bold px-8 py-3 rounded-lg hover:bg-white hover:text-blue-900 transition duration-300">
          PILIHAN MESIN
        </a>
      </div>
    </div>
  </section>

  <!-- 2. KEUNGGULAN & FITUR -->
  <section class="py-16 bg-gray-50 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-800">Keunggulan Vending Machine</h2>
        <p class="text-gray-600 mt-2">Wujudkan bisnis lebih maju dengan beragam fitur dan keunggulan</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100 hover:shadow-lg transition">
          <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mb-4 text-2xl font-bold">⚡</div>
          <h3 class="text-xl font-bold mb-2 text-gray-800">Beroperasi 24/7</h3>
          <p class="text-gray-600">Melayani transaksi pelanggan secara otomatis tanpa henti sepanjang hari.</p>
        </div>
        <!-- Card 2 -->
        <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100 hover:shadow-lg transition">
          <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mb-4 text-2xl font-bold">💳</div>
          <h3 class="text-xl font-bold mb-2 text-gray-800">Pembayaran Cashless</h3>
          <p class="text-gray-600">Mendukung sistem pembayaran QRIS, e-wallet, dan kartu secara praktis.</p>
        </div>
        <!-- Card 3 -->
        <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100 hover:shadow-lg transition">
          <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mb-4 text-2xl font-bold">📊</div>
          <h3 class="text-xl font-bold mb-2 text-gray-800">Dashboard Terintegrasi</h3>
          <p class="text-gray-600">Pantau stok barang dan laporan penjualan secara real-time dari mana saja.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PILIHAN MESIN / KATALOG PRODUK -->
  <section id="produk" class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-800">Pilihan Vending Machine</h2>
        <p class="text-gray-600 mt-2">Jelajahi beragam pilihan mesin untuk setiap kebutuhan bisnis Anda</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Produk 1 -->
        <div class="bg-white border rounded-2xl overflow-hidden shadow-md">
          <div class="h-64 bg-gray-200 flex items-center justify-center text-gray-500 font-bold">
            [ Foto Vending Machine Standar ]
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-800 mb-2">Vending Machine Standar</h3>
            <ul class="text-gray-600 space-y-2 mb-6 text-sm">
              <li>✔ Slot Pengisian hingga 240 item</li>
              <li>✔ Layar Sentuh 50 inch</li>
              <li>✔ Dilengkapi Kompresor Pendingin (4°C - 25°C)</li>
              <li>✔ Cocok untuk Minuman, Snack, atau Suvenir</li>
            </ul>
            <a href="#kontak" class="block text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 rounded-lg transition">Tanya Spesifikasi</a>
          </div>
        </div>

        <!-- Produk 2 -->
        <div class="bg-white border rounded-2xl overflow-hidden shadow-md">
          <div class="h-64 bg-gray-200 flex items-center justify-center text-gray-500 font-bold">
            [ Foto Vending Machine Mini ]
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-800 mb-2">Vending Machine Mini</h3>
            <ul class="text-gray-600 space-y-2 mb-6 text-sm">
              <li>✔ Desain Kompak Hemat Lahan</li>
              <li>✔ Sistem Dashboard Terintegrasi 24/7</li>
              <li>✔ Akses Aman Kunci Fisik + Sensor</li>
              <li>✔ Cocok untuk Kantor dan Area Terbatas</li>
            </ul>
            <a href="#kontak" class="block text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 rounded-lg transition">Tanya Spesifikasi</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SECTION ARTIKEL / BLOG DARI DECAP CMS -->
  <section class="py-16 bg-gray-50 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="flex justify-between items-center mb-8">
        <div>
          <h2 class="text-3xl font-bold text-gray-800">Artikel & Berita Terbaru</h2>
          <p class="text-gray-600 text-sm mt-1">Informasi dan tips seputar bisnis terkini</p>
        </div>
        <a href="/blog" class="text-blue-600 font-bold hover:underline">Lihat Semua Artikel →</a>
      </div>
      <p class="text-gray-500 italic text-center py-8">Artikel yang Anda buat lewat Decap CMS akan otomatis muncul di halaman /blog.</p>
    </div>
  </section>

  <!-- 5. CALL TO ACTION / KONTAK -->
  <section id="kontak" class="bg-gray-900 text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Siap Dongkrak Bisnis Anda ke Level Berikutnya?</h2>
      <p class="text-gray-400 mb-8">Hubungi tim kami sekarang untuk konsultasi skema jual atau sewa mesin.</p>
      <a href="https://wa.me/6281234567890" target="_blank" class="bg-green-500 hover:bg-green-600 text-white font-bold px-8 py-4 rounded-full text-lg shadow-lg inline-flex items-center gap-2 transition">
        💬 CHAT VIA WHATSAPP
      </a>
    </div>
  </section>

</BaseLayout>
